  "description": "LegalLens AI — Enterprise-grade Legal Document Analysis, Risk Detection, and Contract Copilot powered by Google Gemini",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "test": "npm run test:server && npm run test:client",
